#!/bin/bash
set -e

source "$(dirname "$(readlink -f "$0")")/worktree-lib.sh"

# Prompt for GitHub issue URL
issue_url=$(echo "" | fuzzel --dmenu --prompt "GitHub issue URL: ")
[[ -z "$issue_url" ]] && exit 0

# Extract issue number from URL (last number in the path)
issue_num=$(echo "$issue_url" | grep -oE '[0-9]+$')
[[ -z "$issue_num" ]] && notify-send -u critical "Start Ticket Failed" "Could not extract issue number from URL" && exit 1

# Pick the repo container. The one inferred from the URL's org/repo slug
# (matched against each container's origin remote) is pinned on top, so Enter
# confirms it; the issue may still belong in another repo's worktree.
inferred=""
if [[ "$issue_url" =~ github\.com[:/]([^/]+/[^/?#]+) ]]; then
	inferred=$(container_for_github_slug "${BASH_REMATCH[1]}") || inferred=""
fi
container=$(pick_container "$inferred") || exit 0

load_worktreerc "$container"

# A container is itself a valid git dir (its .git file points at .bare), so
# worktrees are created straight from it — no main worktree involved.
[[ -f "$container/.git" ]] || { notify-send -u critical "Start Ticket Failed" "$container is not a git container"; exit 1; }

# What to fork the ticket off. Asked up front, before the Claude call below,
# so every prompt is out of the way before the one step that makes you wait.
# origin's default branch is pinned on top of the menu and is usually the right
# answer; the rest of the list is there for the ticket that builds on another
# branch. pick_base_branch reports its own failures; 1 is a dismissed prompt.
set +e
base_ref=$(pick_base_branch "$container" "Start Ticket")
rc=$?
set -e
((rc == 1)) && exit 0
((rc != 0)) && exit 1

# Use Claude to generate a short descriptive name (for the worktree)
claude_settings='{"permissions":{"allow":["Bash(gh:*)"]}}'
claude_prompt="Given this GitHub issue URL: $issue_url

Use the GitHub CLI (gh) to fetch the issue details - do not try to load from the public URL.

Generate a short descriptive name. Requirements:
- Maximum 25 characters
- Use kebab-case (lowercase with hyphens)
- Be descriptive but concise
- Do NOT include the issue number
- Output ONLY the name, nothing else"

worktree_name=$(with_notification "Starting ticket..." "Generating worktree name..." \
	claude -p --model haiku --setting-sources "" --settings "$claude_settings" "$claude_prompt")

# Validate worktree name isn't empty
[[ -z "${worktree_name//[[:space:]]/}" ]] && notify-send -u critical "Start Ticket Failed" "Could not generate worktree name" && exit 1

# Create branch name by appending issue number
branch="${worktree_name}-${issue_num}"

create_worktree_branch "$container" "$base_ref" "$branch" ||
	{
		notify-send -u critical "Start Ticket Failed" "Failed to create worktree: $branch"
		exit 1
	}

seed_claude_local_md "$container/$branch" "This worktree's purpose is to implement the following GitHub ticket:

$issue_url"

# Work has started: move the ticket to In Progress on every project board
# tracking it. Backgrounded — board updates must never delay the worktree.
github-issue-set-status "$issue_url" "In Progress" &>/dev/null &
# Add (not replace) — other assignees on the ticket stay put.
gh issue edit "$issue_url" --add-assignee @me &>/dev/null &

# Prompt to launch worktree
action=$(notify-send --wait --action="yes=Yes" --action="no=No" "Worktree Ready" "Launch worktree $branch?")
[[ "$action" != "yes" ]] && exit 0

# Launch dev environment via resume-worktree
resume-worktree "$(basename "$container")/$branch" "$issue_url"
