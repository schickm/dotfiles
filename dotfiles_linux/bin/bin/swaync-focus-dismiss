#!/usr/bin/env python3
"""Close swaync notifications for the thing you are currently looking at.

Some notifications outlive the moment they stop being useful, because the app
that raised them never withdraws them. Nothing in the freedesktop protocol tells
a daemon "the user has seen that" -- but the compositor knows what is focused,
so follow niri's focus and clear what the focused window has made redundant.

Two rules, one event loop:

  Slack        Slack calls Notify with expire_timeout=-1 and never follows up
               with CloseNotification, so notifications sit in swaync's control
               center (and its waybar count) after you have read the message.
               The only evidence outside Slack is its window title, which names
               the conversation currently on screen:

                   rwgps-ui (Channel) - Ride with GPS - 1 new item - Slack

               So parse the conversation out of the title and close any Slack
               notification whose summary names the same conversation.

  Claude Code  The hooks (claude-stop-hook.sh, claude-permission-hook.sh) only
               notify when their Kitty window is unfocused, but once a
               notification is up nothing clears it: focusing the window by
               keyboard, waybar or a workspace switch leaves it around forever.
               The hooks register the mapping themselves, one file per
               notification in $XDG_RUNTIME_DIR/claude-notifications:

                   <notification id>  ->  <niri window id>

               Focus that window and its notifications go away. Dismissing a
               permission notification this way makes the hook fall back to the
               in-terminal prompt, which is where you are looking anyway.

swaync's D-Bus interface can close a notification by id (the freedesktop
CloseNotification call) but cannot list active ones, so both rules work from
out-of-band registries: the Claude hooks write theirs, and swaync itself
records Slack notifications via swaync-slack-record (the "scripts" block in
config.json). Closing an id that is already gone is a harmless no-op, which is
what makes registry staleness safe; entries are also pruned by age, and the
Slack registry is cleared on startup since swaync restarts reset its id
counter.

The Slack rule matches on strings rendered by Slack's webapp, not shipped in
the desktop app, so they can change without warning. Every failure here is a
no-op that leaves the current behaviour intact: an unrecognised title or
summary just means the notification stays put, which is what Slack does on its
own anyway.

Only the group-DM summary format ("New message in evan, william") has been seen
in the wild; DM and mention formats are guesses. If a notification lingers after
you have read the conversation, that is the likely reason. To find out:

    systemctl --user stop swaync-focus-dismiss
    swaync-focus-dismiss --debug      # reproduce it, then Ctrl-C
    systemctl --user start swaync-focus-dismiss

--debug prints the conversation parsed out of the Slack window title, the Claude
registrations it declined to act on, plus every Slack summary it declined to
match and why. Closures are logged either way, so `journalctl --user -u
swaync-focus-dismiss` shows what it has been clearing without needing debug
mode.

Runs as swaync-focus-dismiss.service, started with the graphical session.
"""

import json
import os
import re
import select
import subprocess
import sys
import time
from pathlib import Path

# How often to re-check for new notifications while Slack stays focused. Needed
# because a message can arrive while you're already reading the conversation.
# The Claude rule needs no equivalent: its hooks only notify while their window
# is unfocused, so the focus event that makes a notification redundant always
# comes after it.
POLL_INTERVAL = 2.0

# Registry entries older than this are stale (their notification is long gone,
# or its id has been reused by a later swaync session) and get dropped.
MAX_REGISTRY_AGE = 12 * 60 * 60

# "<conversation> (<kind>) - <workspace> - Slack", where kind is Channel, DM,
# and friends. Non-greedy on the name: with an unusual name the worst case is a
# wrong parse that matches no summary, i.e. nothing happens.
TITLE_RE = re.compile(r"^(?P<name>.+?) \([^)]+\) - .*Slack$")

RUNTIME_DIR = Path(os.environ.get("XDG_RUNTIME_DIR", "/tmp"))
# Where the Claude Code hooks register <notification id> -> <niri window id>
# (see register_claude_notification in workspace-lib.sh).
CLAUDE_REGISTRY = RUNTIME_DIR / "claude-notifications"
# Where swaync-slack-record registers <notification id> -> <summary>.
SLACK_REGISTRY = RUNTIME_DIR / "swaync-slack-notifications"

DEBUG = "--debug" in sys.argv[1:]


def log(msg):
    print(msg, file=sys.stderr, flush=True)


def dbg(msg):
    if DEBUG:
        log(msg)


def conversation_from_title(title):
    """The conversation Slack is currently showing, or None if unrecognised."""
    m = TITLE_RE.match(title or "")
    if not m:
        return None
    name = m.group("name").strip()
    # One-character names would match far too eagerly.
    return name if len(name) >= 2 else None


def summary_names(summary, name):
    """Does this notification summary refer to conversation `name`?

    Matches the name as a whole unit so that a "#channel" prefix still counts,
    while the DM "evan" does not swallow notifications from the group DM
    "evan, william" (hence the comma in the trailing guard).
    """
    pattern = r"(?<![\w-])" + re.escape(name) + r"(?![\w,-])"
    return re.search(pattern, summary or "", re.IGNORECASE) is not None


def close(notif_id, why):
    """Close one notification via the freedesktop D-Bus call.

    A dead id is a no-op at the daemon, so this can't misfire on stale
    registry entries; it only fails if the bus itself is unreachable.
    """
    try:
        subprocess.run(
            [
                "gdbus", "call", "--session",
                "--dest", "org.freedesktop.Notifications",
                "--object-path", "/org/freedesktop/Notifications",
                "--method", "org.freedesktop.Notifications.CloseNotification",
                str(notif_id),
            ],
            capture_output=True, check=True,
        )
        log(f"closed {notif_id}: {why}")
        return True
    except (OSError, subprocess.CalledProcessError) as e:
        dbg(f"close {notif_id} failed: {e}")
        return False


def registry_entries(registry):
    """{notification id: file content} for a registry dir, pruning junk.

    A file that doesn't parse is the writer's bug, not ours, and an old file's
    id may have been reused by a later swaync session: drop both so one bad
    write can't wedge a rule forever.
    """
    out = {}
    try:
        entries = list(registry.iterdir())
    except OSError:  # not created yet, or no writer has ever run
        return out
    cutoff = time.time() - MAX_REGISTRY_AGE
    for path in entries:
        try:
            if path.stat().st_mtime < cutoff:
                dbg(f"pruned {registry.name}/{path.name}: older than max age")
                path.unlink(missing_ok=True)
                continue
            out[int(path.name)] = path.read_text().strip()
        except (ValueError, OSError) as e:
            dbg(f"dropping unparseable registration {path.name}: {e}")
            try:
                path.unlink()
            except OSError:
                pass
    return out


def unregister(registry, notif_id):
    try:
        (registry / str(notif_id)).unlink()
    except OSError:
        pass


def dismiss_slack(name):
    """Clear Slack notifications naming the conversation on screen."""
    for notif_id, summary in registry_entries(SLACK_REGISTRY).items():
        if summary_names(summary, name):
            close(notif_id, f"{summary!r} (viewing {name!r})")
            unregister(SLACK_REGISTRY, notif_id)
        else:
            dbg(f"kept {notif_id}: {summary!r} does not name {name!r}")


def dismiss_claude(focused_id):
    """Clear Claude Code notifications belonging to the newly focused window."""
    for notif_id, window_id in registry_entries(CLAUDE_REGISTRY).items():
        try:
            window_id = int(window_id)
        except ValueError:
            unregister(CLAUDE_REGISTRY, notif_id)
            continue
        if window_id == focused_id:
            if close(notif_id, f"claude window {window_id} focused"):
                unregister(CLAUDE_REGISTRY, notif_id)
        else:
            dbg(f"kept {notif_id}: window {window_id} is not the focused {focused_id}")


class Windows:
    """niri's window list, kept current from the event stream."""

    def __init__(self):
        self.by_id = {}
        self.focused = None

    def apply(self, event):
        for kind, payload in event.items():
            if kind == "WindowsChanged":
                self.by_id = {w["id"]: w for w in payload["windows"]}
                focused = [w["id"] for w in payload["windows"] if w.get("is_focused")]
                self.focused = focused[0] if focused else None
            elif kind == "WindowOpenedOrChanged":
                w = payload["window"]
                self.by_id[w["id"]] = w
                if w.get("is_focused"):
                    self.focused = w["id"]
            elif kind == "WindowClosed":
                self.by_id.pop(payload["id"], None)
            elif kind == "WindowFocusChanged":
                self.focused = payload.get("id")

    def focused_conversation(self):
        """Conversation name if Slack is focused and showing one, else None."""
        w = self.by_id.get(self.focused)
        if not w or w.get("app_id") != "slack":
            return None
        return conversation_from_title(w.get("title"))


def main():
    # Slack ids don't survive a swaync restart (its counter resets), and this
    # daemon restarts with the session: start from a clean slate. The Claude
    # registry is left alone -- its writers outlive us and clean up themselves.
    for stale in registry_entries(SLACK_REGISTRY):
        unregister(SLACK_REGISTRY, stale)

    try:
        niri = subprocess.Popen(
            ["niri", "msg", "-j", "event-stream"],
            stdout=subprocess.PIPE,
            text=True,
        )
    except OSError as e:
        log(f"cannot start niri event stream: {e}")
        return 1

    windows = Windows()
    state = None  # (focused id, conversation) last acted on

    while True:
        conversation = windows.focused_conversation()
        # Only tick while Slack is focused; otherwise block until niri speaks.
        ready, _, _ = select.select(
            [niri.stdout], [], [], POLL_INTERVAL if conversation else None
        )

        if not ready:
            dismiss_slack(conversation)  # periodic re-check, same conversation
            continue

        line = niri.stdout.readline()
        if not line:
            log("niri event stream closed")
            return 1  # let systemd restart us against the new compositor
        try:
            windows.apply(json.loads(line))
        except (ValueError, KeyError, TypeError) as e:
            dbg(f"skipped unparseable event: {e}")
            continue

        conversation = windows.focused_conversation()
        current = (windows.focused, conversation)
        if current != state:
            if conversation:
                dbg(f"slack showing {conversation!r}")
                dismiss_slack(conversation)
            if windows.focused is not None:
                dismiss_claude(windows.focused)
        state = current


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(0)
