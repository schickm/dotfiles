#!/usr/bin/env bash
# handy-paste — external paste script for Handy (https://github.com/cjpais/Handy)
#
# Why: Handy's Parakeet model often omits the final period, so consecutive
# dictations run together. This script adds a "." when the transcription has
# no terminal punctuation (existing ? ! . : ; , … are kept, including when
# followed by closing quotes/brackets), then pastes the text via the
# clipboard and restores whatever was on the clipboard before.
#
# Setup:
#   1. Stow this package so the script is at ~/bin/handy-paste
#      (stow -d ~/vc/dotfiles/dotfiles_linux -t ~ bin).
#   2. In Handy's settings (advanced/experimental section):
#        - Paste method:  External script
#        - Script path:   /home/<user>/bin/handy-paste   (absolute path)
#      These map to "paste_method": "external_script" and
#      "external_script_path" in ~/.local/share/com.pais.handy/settings_store.json.
#   3. Keep "append trailing space" on if you want dictations separated;
#      Handy appends the space before calling this script, and it is preserved.
#
# Interface: Handy runs `handy-paste "<text>"` (text is argv[1]; stdin/stdout
# are not connected) and waits for it to exit. The script must do the paste.
#
# Requirements: Wayland, wl-clipboard (wl-copy/wl-paste), wtype.
#
# Limitations:
#   - Pastes with Ctrl+V; terminals that need Ctrl+Shift+V won't receive it.
#   - Only the clipboard's first MIME type is saved/restored.
#   - If an app reads the clipboard later than the 0.25s delay below, it gets
#     the old contents; raise the sleep if that happens.
text="$1"
[[ -z "${text//[[:space:]]/}" ]] && exit 0

# Keep any trailing whitespace (Handy's append_trailing_space) to re-add later.
body="${text%"${text##*[![:space:]]}"}"
tail="${text:${#body}}"

# Look past closing quotes/brackets: `"stop."` is terminated, `(the docs)` is not.
core="$body"
while [[ "$core" == *[\"\'\)\]”’] ]]; do core="${core%?}"; done
case "${core: -1}" in
  [.\?\!:\;,…]) ;;
  *) body="${body}." ;;
esac

out="${body}${tail}"

# Save the current clipboard (its first offered MIME type) so it can be restored.
saved="$(mktemp "${XDG_RUNTIME_DIR:-/tmp}/handy-clip.XXXXXX")"
trap 'rm -f "$saved"' EXIT
type="$(wl-paste --list-types 2>/dev/null | head -n1)"
if [[ -n "$type" ]]; then
  wl-paste --no-newline --type "$type" >"$saved" 2>/dev/null || type=""
fi

printf '%s' "$out" | wl-copy --type 'text/plain;charset=utf-8'
sleep 0.05
wtype -M ctrl -k v -m ctrl
# Give the focused app time to read the clipboard before restoring it.
sleep 0.25

if [[ -n "$type" ]]; then
  wl-copy --type "$type" <"$saved"
else
  wl-copy --clear
fi
